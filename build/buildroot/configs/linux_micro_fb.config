# Linux config fragment: graphics for the native renderer (native/renderer).
#
# NOT YET MERGED into linux_micro.config — untested on a real boot. To try it,
# append this file to linux_micro.config, rebuild the micro image, then boot
# QEMU with `-vga std` (bochs) or `-device virtio-gpu-pci` and run:
#   llmos-render tree.json --fb /dev/fb0
#
# DRM drivers with fbdev emulation give a classic /dev/fb0 that the renderer
# writes to directly. SIMPLEDRM covers real hardware booted via UEFI GOP.

CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Keyboard and mouse events for when the renderer becomes interactive
CONFIG_INPUT_EVDEV=y
